# Copy this file to .env and fill in the secrets before starting the stack.
# NEVER commit the real .env file (it is listed in .gitignore).

# Magento application
MAGENTO_REPO=http-basic.repo.magento.com
MAGENTO_VERSION=magento/project-community-edition
MAGENTO_SAMPLE_CONTENT=no
# Set to "yes" only for local/dev installs without email configured for 2FA codes.
# Leave as "no" (or unset) for production so Two-Factor Authentication stays enabled.
DISABLE_2FA=no
# Space-separated list of extra Composer packages to require during install,
# e.g. a community language pack: EXTRA_COMPOSER_PACKAGES=snowdog/language-pl_pl
EXTRA_COMPOSER_PACKAGES=
# Space-separated list of locales to deploy static content for.
# Add every locale you want selectable with full UI translations, e.g: en_US pl_PL
STATIC_CONTENT_LOCALES=en_US
BASE_URL=http://magento.local/
TIMEZONE=UTC
CURRENCY=USD
ADMIN_EMAIL=
ADMIN_PASSWORD=
API_KEY=
API_SECRET=
SEARCH_ENGINE=opensearch
SEARCH_HOST=opensearch
SEARCH_PORT=9200
